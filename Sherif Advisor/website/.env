# ===========================================
# LOCAL DEVELOPMENT — MySQL (GoDaddy hosted DB)
# ===========================================
# Prisma builds the connection URL from either DATABASE_URL (below) or the
# individual DB_* parts. For local dev, paste the GoDaddy MySQL connection
# string here. Get the values from GoDaddy → Settings → Secrets.
#
# Format: mysql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DBNAME"

# Alternatively, set the individual parts (same as GoDaddy injects):
# DB_HOST=
# DB_PORT=3306
# DB_NAME=
# DB_USER=
# DB_PASSWORD=

# ===========================================
# Auth & Admin
# ===========================================
JWT_SECRET=your-secret-key-change-in-production
AUTH_SECRET=your-jwt-secret-minimum-32-characters-here

# Admin Portal Credentials (used by seed script)
ADMIN_EMAIL=admin@sherifadvisory.com
ADMIN_PASSWORD=ChangeMe123!
