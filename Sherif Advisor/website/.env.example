# ===========================================
# Sherif Yousry Advisory - Environment Config
# ===========================================
# COPY this file to .env.local and fill in values
# NEVER commit .env.local to version control

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Authentication (JWT)
AUTH_SECRET=your-jwt-secret-minimum-32-characters-here
AUTH_TOKEN_EXPIRY=8h
JWT_SECRET=your-secret-key-change-in-production

# Admin Portal Credentials (used by seed script)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123

# Database (SQLite for development)
DATABASE_URL="file:./prisma/dev.db"

# Email Service (future)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@sherifadvisory.com
SMTP_PASSWORD=

# AI Chatbot (future)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4

# File Storage (future - for client documents)
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=me-south-1

# Encryption (for sensitive client data)
ENCRYPTION_KEY=your-256-bit-encryption-key

# Rate Limiting (production - Redis)
REDIS_URL=redis://localhost:6379

# Analytics (optional)
NEXT_PUBLIC_GA_ID=
